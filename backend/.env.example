# PostgreSQL connection string (Railway provides this automatically).
# Leave unset to use SQLite locally (sqlite:///./finance.db).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret key used to sign JWTs — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Comma-separated list of allowed CORS origins.
# In production, set this to your Cloudflare Pages URL.
CORS_ORIGINS=https://your-app.pages.dev
