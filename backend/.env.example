# PostgreSQL connection string (Railway provides this automatically).
# Leave unset to use SQLite locally (sqlite:///./finance.db).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret key used to sign JWTs — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Comma-separated list of allowed CORS origins.
# In production, set this to your Cloudflare Pages URL.
CORS_ORIGINS=https://your-app.pages.dev

# Admin API key — protects /api/admin/* endpoints.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_KEY=changeme

# Base URL of the deployed frontend — used to build links in emails (e.g.
# password reset). Falls back to the first CORS_ORIGINS entry if unset, but
# set this explicitly in production — don't rely on the fallback.
# In production, set this to your Cloudflare Pages URL (same as CORS_ORIGINS).
FRONTEND_URL=https://your-app.pages.dev

# Resend API key — used to send transactional email (e.g. password reset).
# Get one from https://resend.com. The app runs fine without it; emails just
# won't send (logged, not fatal).
RESEND_API_KEY=changeme
